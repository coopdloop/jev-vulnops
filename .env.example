# jev-vulnops configuration. Copy to .env and fill in ONE of the two routes.

# Route 1: TypeSafe direct (key from the TypeSafe console)
TYPESAFE_API_KEY=ts-...

# Route 2: OpenRouter (SDK routes via OpenRouter; billing on your OpenRouter account)
# TYPESAFE_BASE_URL=https://openrouter.ai/api
# TYPESAFE_API_KEY=sk-or-...
